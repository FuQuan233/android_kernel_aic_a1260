// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;
#include "mt6580.dtsi"
#include <dt-bindings/clock/mt6580-clk.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/mt65xx.h>

/ {
	model = "Wingtech WT6580 WE N (JD9161)";
	compatible = "wingtech,wt6580-we-n", "mediatek,mt6580";
	/* Match the cell widths used by the vendor LK's DT fixups. */
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		mmc0 = &mmc0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
	};

	chosen {
		stdout-path = "serial0:921600n8";
		bootargs = "earlycon console=ttyS0,921600n8 rdinit=/init";
	};

	/* Native GPIO/scan-code order recovered from the original 3.18 kernel. */
	remote_keys: remote-keys {
		compatible = "gpio-keys";
		label = "a1260-remote";

		key-0 {
			label = "remote-aw9523-0";
			linux,code = <KEY_RIGHT>;
			gpios = <&remote_gpio 0 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-1 {
			label = "remote-aw9523-1";
			linux,code = <KEY_F2>;
			gpios = <&remote_gpio 1 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-2 {
			label = "remote-aw9523-2";
			linux,code = <KEY_UP>;
			gpios = <&remote_gpio 2 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-3 {
			label = "remote-aw9523-3";
			linux,code = <KEY_ENTER>;
			gpios = <&remote_gpio 3 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-4 {
			label = "remote-aw9523-4";
			linux,code = <KEY_F1>;
			gpios = <&remote_gpio 4 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-5 {
			label = "remote-aw9523-5";
			linux,code = <KEY_LEFT>;
			gpios = <&remote_gpio 5 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-6 {
			label = "remote-aw9523-6";
			linux,code = <KEY_DOWN>;
			gpios = <&remote_gpio 6 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-7 {
			label = "remote-aw9523-7";
			linux,code = <KEY_BACK>;
			gpios = <&remote_gpio 7 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-8 {
			label = "remote-aw9523-8";
			linux,code = <KEY_MENU>;
			gpios = <&remote_gpio 8 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-9 {
			label = "remote-aw9523-9";
			linux,code = <KEY_F5>;
			gpios = <&remote_gpio 9 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-10 {
			label = "remote-aw9523-10";
			linux,code = <KEY_F4>;
			gpios = <&remote_gpio 10 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-11 {
			label = "remote-aw9523-11";
			linux,code = <KEY_F3>;
			gpios = <&remote_gpio 11 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-12 {
			label = "remote-aw9523-12";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&remote_gpio 12 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-13 {
			label = "remote-aw9523-13";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&remote_gpio 13 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-14 {
			label = "remote-aw9523-14";
			linux,code = <KEY_HOME>;
			gpios = <&remote_gpio 14 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-15 {
			label = "remote-aw9523-15";
			linux,code = <KEY_F6>;
			gpios = <&remote_gpio 15 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-aw9106-3 {
			label = "remote-aw9106-3";
			linux,code = <KEY_F8>;
			gpios = <&remote_aux_gpio 3 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};

		key-aw9106-4 {
			label = "remote-aw9106-4";
			linux,code = <KEY_F7>;
			gpios = <&remote_aux_gpio 4 GPIO_ACTIVE_HIGH>;
			debounce-interval = <16>;
		};
	};

	/* Battery characterization and NTC values from the MT6580 reference BSP. */
	battery_cell: battery-cell {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <1397000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4200000>;
		precharge-current-microamp = <512000>;
		charge-term-current-microamp = <256000>;
		constant-charge-current-max-microamp = <512000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		ocv-capacity-celsius = <0 25 50>;
		ocv-capacity-table-0 =
			<4153000 100>,
			<4131000 96>,
			<4113000 92>,
			<4098000 87>,
			<4085000 83>,
			<4075000 79>,
			<4067000 75>,
			<4059000 71>,
			<4051000 67>,
			<4044000 62>,
			<4038000 58>,
			<4030000 54>,
			<4022000 50>,
			<4014000 46>,
			<4007000 42>,
			<4001000 38>,
			<3994000 34>,
			<3986000 29>,
			<3981000 25>,
			<3974000 21>,
			<3968000 17>,
			<3960000 13>,
			<3950000 9>,
			<3939000 4>,
			<3923000 0>;
		ocv-capacity-table-1 =
			<4167000 100>,
			<4148000 99>,
			<4131000 97>,
			<4116000 96>,
			<4103000 94>,
			<4089000 93>,
			<4075000 91>,
			<4063000 90>,
			<4051000 89>,
			<4041000 87>,
			<4029000 86>,
			<4017000 84>,
			<4008000 83>,
			<3998000 81>,
			<3987000 80>,
			<3978000 79>,
			<3970000 77>,
			<3960000 76>,
			<3952000 74>,
			<3945000 73>,
			<3935000 71>,
			<3928000 70>,
			<3920000 69>,
			<3912000 67>,
			<3905000 66>,
			<3896000 64>,
			<3889000 63>,
			<3878000 61>,
			<3866000 60>,
			<3855000 59>,
			<3844000 57>,
			<3836000 56>,
			<3830000 54>,
			<3823000 53>,
			<3818000 51>,
			<3814000 50>,
			<3807000 49>,
			<3804000 47>,
			<3801000 46>,
			<3797000 44>,
			<3793000 43>,
			<3791000 41>,
			<3787000 40>,
			<3785000 39>,
			<3782000 37>,
			<3781000 36>,
			<3777000 34>,
			<3775000 31>,
			<3773000 30>,
			<3772000 29>,
			<3769000 27>,
