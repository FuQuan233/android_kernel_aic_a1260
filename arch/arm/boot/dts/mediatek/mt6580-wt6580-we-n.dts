			<3746000 20>,
			<3741000 19>,
			<3736000 17>,
			<3728000 16>,
			<3719000 14>,
			<3712000 13>,
			<3701000 11>,
			<3689000 10>,
			<3684000 9>,
			<3681000 7>,
			<3675000 6>,
			<3671000 4>,
			<3665000 3>,
			<3650000 1>,
			<3599000 0>;
		ocv-capacity-table-2 =
			<4173000 100>,
			<4155000 99>,
			<4142000 97>,
			<4127000 96>,
			<4115000 94>,
			<4102000 93>,
			<4091000 92>,
			<4078000 90>,
			<4066000 89>,
			<4055000 87>,
			<4045000 86>,
			<4034000 85>,
			<4023000 83>,
			<4012000 82>,
			<4002000 81>,
			<3992000 79>,
			<3984000 78>,
			<3975000 76>,
			<3966000 75>,
			<3957000 74>,
			<3949000 72>,
			<3940000 71>,
			<3932000 69>,
			<3924000 68>,
			<3917000 67>,
			<3910000 65>,
			<3903000 64>,
			<3896000 62>,
			<3888000 61>,
			<3880000 60>,
			<3870000 58>,
			<3857000 57>,
			<3845000 56>,
			<3836000 54>,
			<3830000 53>,
			<3822000 51>,
			<3818000 50>,
			<3813000 49>,
			<3809000 47>,
			<3805000 46>,
			<3801000 44>,
			<3797000 43>,
			<3792000 42>,
			<3789000 40>,
			<3787000 39>,
			<3784000 38>,
			<3781000 36>,
			<3780000 35>,
			<3776000 33>,
			<3774000 32>,
			<3772000 31>,
			<3768000 29>,
			<3764000 28>,
			<3759000 26>,
			<3751000 25>,
			<3749000 24>,
			<3745000 22>,
			<3741000 21>,
			<3735000 19>,
			<3731000 18>,
			<3725000 17>,
			<3720000 15>,
			<3712000 14>,
			<3703000 13>,
			<3697000 11>,
			<3685000 10>,
			<3677000 8>,
			<3675000 7>,
			<3672000 4>,
			<3669000 3>,
			<3655000 1>,
			<3612000 0>;
	};

	/* Keep the vendor /memory path for old bootloader memory fixups. */
	memory {
		device_type = "memory";
		/* Captured from the running device, excluding the top 6 MiB. */
		reg = <0 0x80000000 0 0x3fa00000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Keep the vendor kernel's dynamic connectivity/modem carve-outs. */
		connectivity {
			size = <0 0x200000>;
			alignment = <0 0x200000>;
			no-map;
		};

		modem {
			size = <0 0x1800000>;
			alignment = <0 0x2000000>;
			alloc-ranges = <0 0x80000000 0 0x80000000>;
			no-map;
		};

		ram-console@83f00000 {
			reg = <0 0x83f00000 0 0x10000>;
			no-map;
		};

		legacy-pstore-prefix@83f10000 {
			reg = <0 0x83f10000 0 0xaf000>;
			no-map;
		};

		/* Match the vendor ramoops console zone for recovery after reboot. */
		ramoops@83fbf000 {
			compatible = "ramoops";
			reg = <0 0x83fbf000 0 0x10000>;
			/* Avoid a small-page island beside a section in one ARM PMD. */
			no-map;
			console-size = <0x10000>;
		};

		legacy-pstore-suffix@83fcf000 {
			reg = <0 0x83fcf000 0 0x31000>;
			no-map;
		};

		minirdump@83ff0000 {
			reg = <0 0x83ff0000 0 0x10000>;
			no-map;
		};

		/* Packed live atag,videolfb; top 6 MiB is outside /memory. */
		lk_framebuffer: framebuffer@bfa00000 {
			reg = <0 0xbfa00000 0 0x600000>;
			no-map;
		};
	};

	/* Read existing scanout registers; retain LK's clocks, PHY and panel. */
	display@14007000 {
		compatible = "wingtech,wt6580-lkfb";
		reg = <0 0x14007000 0 0x1000>,
		      <0 0x14009000 0 0x1000>,
		      <0 0x14012000 0 0x1000>,
		      <0 0x14018000 0 0x1000>,
		      <0 0x14000000 0 0x1000>;
		reg-names = "ovl", "rdma", "dsi", "mipi", "mmsys";
		memory-region = <&lk_framebuffer>;
	};

	watchdog@10007000 {
		compatible = "mediatek,mt6580-wdt", "mediatek,mt6589-wdt";
		reg = <0 0x10007000 0 0x100>;
		timeout-sec = <30>;
	};

	pmic-wrap@1000f000 {
		compatible = "mediatek,mt6580-firmware-pwrap";
		reg = <0 0x1000f000 0 0x1000>;

		reboot-mode {
			compatible = "wingtech,wt6580-reboot-mode";
		};

		regulators {
			compatible = "mediatek,mt6350-regulator";

			vtouch: ldo_vgp1 {
				regulator-name = "vtouch";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};
		};

		pmic {
			compatible = "mediatek,mt6350";
			interrupt-parent = <&pio>;
			/* Old DT names GPIO13; its PMIC function routes to EINT17. */
			interrupts = <17 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&pmic_irq_pin>;
			interrupt-controller;
			#interrupt-cells = <2>;

			keys {
				compatible = "mediatek,mt6350-keys";
				mediatek,long-press-mode = <1>;
				power-off-time-sec = <0>;
				power {
					linux,keycodes = <KEY_POWER>;
					wakeup-source;
				};
			};

			battery {
				compatible = "mediatek,mt6350-battery";
				monitored-battery = <&battery_cell>;
				power-supplies = <&charger>;
			};
		};
	};

	topckgen: clock-controller@10000000 {
		compatible = "mediatek,mt6580-topckgen";
		reg = <0 0x10000000 0 0x1000>;
		#clock-cells = <1>;
	};

	apmixedsys: clock-controller@10018000 {
		compatible = "mediatek,mt6580-apmixedsys";
		reg = <0 0x10018000 0 0x1000>;
		#clock-cells = <1>;
	};

	pio: pinctrl@10005000 {
		compatible = "mediatek,mt6580-pinctrl";
		reg = <0 0x10005000 0 0x1000>,
		      <0 0x10014000 0 0x1000>,
		      <0 0x10015000 0 0x1000>,
		      <0 0x10016000 0 0x1000>,
		      <0 0x10017000 0 0x1000>,
		      <0 0x1000b000 0 0x1000>;
		reg-names = "gpio", "iocfg-t", "iocfg-b", "iocfg-l", "iocfg-r", "eint";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pio 0 0 93>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;

		pmic_irq_pin: pmic-irq-pin {
			pins {
				pinmux = <(MTK_PIN_NO(13) | 1)>;
				input-enable;
				bias-disable;
			};
		};

		i2c0_pins: i2c0-pins {
			pins {
				pinmux = <(MTK_PIN_NO(58) | 1)>,
					 <(MTK_PIN_NO(61) | 1)>;
				input-enable;
			};
		};

		i2c1_pins: i2c1-pins {
			pins {
				pinmux = <(MTK_PIN_NO(59) | 1)>,
					 <(MTK_PIN_NO(62) | 1)>;
				input-enable;
			};
		};

		i2c2_pins: i2c2-pins {
			pins {
				pinmux = <(MTK_PIN_NO(60) | 1)>,
					 <(MTK_PIN_NO(63) | 1)>;
				input-enable;
			};
		};

		remote_irq_pin: remote-irq-pin {
			pins {
				pinmux = <(MTK_PIN_NO(4) | 6)>;
				input-enable;
				bias-disable;
			};
		};

		remote_aux_irq_pin: remote-aux-irq-pin {
			pins {
				pinmux = <(MTK_PIN_NO(6) | 6)>;
				input-enable;
				bias-disable;
			};
		};

		touch_pins: touch-pins {
			pins {
				pinmux = <(MTK_PIN_NO(5) | 6)>;
				input-enable;
				bias-disable;
			};
		};
	};


	i2c0: i2c@11009000 {
		compatible = "mediatek,mt6580-i2c";
		reg = <0 0x11009000 0 0x1000>, <0 0x11000180 0 0x80>;
		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_MT6580_TOP_I2C0>,
			 <&topckgen CLK_MT6580_TOP_APDMA>;
		clock-names = "main", "dma";
		clock-div = <10>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		charger: charger@6b {
			compatible = "ti,bq24296";
			reg = <0x6b>;
			/* Original board has no independent charger IRQ in its DT. */
			poll-interval = <2000>;
			input-current-limit-microamp = <500000>;
			disable-reset;
			omit-battery-class;
			monitored-battery = <&battery_cell>;
			ti,system-minimum-microvolt = <3500000>;
		};
	};

	i2c1: i2c@1100a000 {
		compatible = "mediatek,mt6580-i2c";
		reg = <0 0x1100a000 0 0x1000>, <0 0x11000200 0 0x80>;
		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_MT6580_TOP_I2C1>,
			 <&topckgen CLK_MT6580_TOP_APDMA>;
		clock-names = "main", "dma";
		clock-div = <10>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		remote_gpio: gpio@5b {
			compatible = "awinic,aw9523-pinctrl";
			reg = <0x5b>;
			interrupt-parent = <&pio>;
			interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&remote_gpio 0 0 16>;
			/* This driver expresses RSTN as raw low then raw high. */
			reset-gpios = <&pio 72 GPIO_ACTIVE_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&remote_irq_pin>;
		};

		touchscreen@38 {
			compatible = "focaltech,ft6336u";
			reg = <0x38>;
			interrupt-parent = <&pio>;
			interrupts = <5 IRQ_TYPE_EDGE_FALLING>;
			reset-gpios = <&pio 2 GPIO_ACTIVE_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&touch_pins>;
			vcc-supply = <&vtouch>;
			touchscreen-size-x = <480>;
			touchscreen-size-y = <800>;
		};
	};

	i2c2: i2c@1100b000 {
		compatible = "mediatek,mt6580-i2c";
		reg = <0 0x1100b000 0 0x1000>, <0 0x11000280 0 0x80>;
		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_MT6580_TOP_I2C2>,
			 <&topckgen CLK_MT6580_TOP_APDMA>;
		clock-names = "main", "dma";
		clock-div = <10>;
		clock-frequency = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c2_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		remote_aux_gpio: gpio@5b {
			compatible = "awinic,aw9106";
			reg = <0x5b>;
			interrupt-parent = <&pio>;
			interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			reset-gpios = <&pio 73 GPIO_ACTIVE_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&remote_aux_irq_pin>;
		};
	};

	/* Vendor msdc_emmc_power() uses VEMC=3.0 V; PMIC control is pending. */
	vemc: regulator-vemc {
		compatible = "regulator-fixed";
		regulator-name = "vemc-firmware";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	mmc0: mmc@11120000 {
		compatible = "mediatek,mt6580-mmc";
		reg = <0 0x11120000 0 0x10000>;
		interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_MT6580_TOP_MSDC0>,
			 <&topckgen CLK_MT6580_TOP_MSDC0>;
		clock-names = "source", "hclk";
		bus-width = <8>;
		max-frequency = <26000000>;
		non-removable;
		no-sd;
		no-sdio;
		vmmc-supply = <&vemc>;
		/* No voltage switching until pinctrl and PMIC are ported. */
		mediatek,firmware-pins;
	};

	usbphy: phy@11110800 {
		compatible = "mediatek,mt6580-usbphy";
		reg = <0 0x11110800 0 0x800>;
		clocks = <&apmixedsys CLK_MT6580_APMIXED_USB48M>;
		clock-names = "ref";
		#phy-cells = <0>;
	};

	usb: usb@11100000 {
		compatible = "mediatek,mt6580-musb", "mediatek,mtk-musb";
		reg = <0 0x11100000 0 0x1000>;
		interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "mc";
		clocks = <&topckgen CLK_MT6580_TOP_USB>,
			 <&topckgen CLK_MT6580_TOP_USB>,
			 <&apmixedsys CLK_MT6580_APMIXED_UNIV48M>;
		clock-names = "main", "mcu", "univpll";
		phys = <&usbphy>;
		dr_mode = "peripheral";
	};
};

/* All inherited MMIO ranges must follow the board's two-cell root. */
&timer {
	reg = <0 0x10008000 0 0x80>;
};

&sysirq {
	reg = <0 0x10200100 0 0x1c>;
	#address-cells = <0>;
};

&gic {
	reg = <0 0x10211000 0 0x1000>,
	      <0 0x10212000 0 0x2000>,
	      <0 0x10214000 0 0x2000>,
	      <0 0x10216000 0 0x2000>;
	#address-cells = <0>;
};

&uart0 {
	reg = <0 0x11005000 0 0x400>;
	status = "okay";
};

&uart1 {
	reg = <0 0x11006000 0 0x400>;
};
