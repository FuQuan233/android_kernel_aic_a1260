config MALI400
	tristate "Mali-400 Utgard r8p0 legacy userspace driver (MT6580)"
	depends on ARM && ARCH_MEDIATEK && OF && PM && HAS_DMA
	depends on DRM_LIMA = n
	select DMA_SHARED_BUFFER
	select SYNC_FILE
	help
	  GPL Arm Utgard r8p0-00dev0 driver adapted for Linux 6.18 and the
	  MT6580 Mali-400 MP2. Provides the original API 900 /dev/mali ABI
	  for matching proprietary EGL/GLES userspace, with dma-buf and
	  Linux sync_file support. This is separate from the KMS display driver.

	  Runtime and system PM are supported. The shared supply remains under
	  CPU voltage control; optional devfreq changes only GPU clock sources.
	  Protected rendering is not supported.
	  Disable Lima: both drivers target the same GPU and cannot own it
	  simultaneously. No proprietary userspace binaries are included.

config MALI400_DEBUG
	bool "Utgard driver debugging and assertions"
	depends on MALI400
	help
	  Compile the DDK's diagnostic messages and internal assertions.
	  The mali_debug_level parameter controls message verbosity at runtime.

config MALI400_DEVFREQ
	bool "MT6580 Utgard devfreq clock scaling"
	depends on MALI400 && PM_DEVFREQ && PM_OPP
	select DEVFREQ_GOV_SIMPLE_ONDEMAND
	help
	  Use the five BSP GPU clock steps from 107.25 to 500.5 MHz with
	  measured busy time and the simple ondemand governor. The CPU's
	  shared VPROC supply must remain at or above 1.15 V; GPU devfreq
	  never changes its voltage. Runtime suspend stops polling.
